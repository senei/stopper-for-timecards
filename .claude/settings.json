{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.mjs\"",
            "timeout": 110
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/end-of-turn.mjs\"", "timeout": 360 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Read",
      "Edit",
      "Write",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebSearch",
      "WebFetch(domain:render.com)",
      "WebFetch(domain:www.netlify.com)",
      "WebFetch(domain:cli.netlify.com)",
      "Bash(powershell -NoProfile -Command \"Set-Clipboard '/10x-implement'\")",
      "Bash(clip.exe)",
      "Bash(npx wrangler *)",
      "Bash(npx supabase *)",
      "Bash(git fetch *)",
      "Bash(git rev-list *)",
      "Bash(gh auth *)",
      "Bash(gh repo *)",
      "Bash(git config *)",
      "Read(//c/Program Files/**)",
      "Read(//c/Program Files \\\\\\(x86\\\\\\)/**)",
      "Read(//c/ProgramData/chocolatey/lib/**)",
      "Bash(powershell -NoProfile -Command \"winget list --id GitHub.cli\")",
      "Bash(powershell -NoProfile -Command \"winget install --id GitHub.cli --silent --accept-package-agreements --accept-source-agreements\")",
      "Bash(tail -n 40 \"C:\\\\Users\\\\MAKGRU\\\\AppData\\\\Local\\\\Packages\\\\Microsoft.DesktopAppInstaller_8wekyb3d8bbwe\\\\LocalState\\\\DiagOutputDir\\\\GitHub.cli.2.101.0-26-09-17-15-34-04.log\" 2>&1)",
