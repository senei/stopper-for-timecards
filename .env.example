SUPABASE_URL=###
SUPABASE_KEY=###
# Server-only. Used to create and look up links; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=###

# Cloudflare Turnstile. These are Cloudflare's documented dummy test keys: they always pass and
# accept the dummy token XXXX.DUMMY.TOKEN.XXXX. Production secrets reject dummy tokens, so set the
# real keys with `npx wrangler secret put` on the deployed Worker.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Owner switch: set to 1 (or true) to stop all new link creation. Existing links keep working.
# Leave unset or empty to keep creation open.
LINK_CREATION_CLOSED=
