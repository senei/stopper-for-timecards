# Copy to .env (git-ignored) and fill in.
OPENROUTER_API_KEY=
# Pick a current model id from https://openrouter.ai/models (supports structured output).
REVIEWER_MODEL=

# Optional, normally set by the CI action:
# Pull request title and description, added to the prompt (the description is cut to 4000 characters).
# PR_TITLE=
# PR_BODY=
# Stop with exit code 3 before any model call when the diff has more characters than this.
# MAX_DIFF_CHARS=
