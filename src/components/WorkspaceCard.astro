---
import PageCard from "@/components/PageCard.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Button, buttonVariants } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { cn } from "@/lib/utils";
import type { Project } from "@/lib/projects";
import type { CurrentTimer } from "@/lib/timer";
import { elapsedWholeHours, isTimerFlagged } from "@/lib/timer-flag";
import { headingAtIndex, headingForDate } from "@/lib/workspace-headings";

interface Props {
  unavailable?: boolean;
  bannerError?: string | null;
  bannerStatus?: string | null;
  currentTimer: CurrentTimer;
  projects: Project[];
  token: string;
  startAction: string;
  switchAction: string;
  stopAction: string;
  workspaceUrl: string;
  /** The moment used to decide whether the running timer is flagged as long-running. Defaults to now; the kitchen sink pins it. */
  now?: Date;
  /** Pins the daily heading to this index and turns the browser-side date correction off (kitchen sink, screenshots). */
  headingIndex?: number;
  /** Render only the card, without the full-height page wrapper. */
  embedded?: boolean;
  /** Renders the primary submit button as in flight (disabled, aria-busy). For the kitchen sink. */
  busy?: boolean;
  /** Renders the Copy button and its message in this state. For the kitchen sink; the page always starts idle. */
  copyState?: "idle" | "copied" | "failed";
}

const {
  unavailable = false,
  bannerError = null,
  bannerStatus = null,
  currentTimer,
  projects,
  token,
  startAction,
  switchAction,
  stopAction,
  workspaceUrl,
  now = new Date(),
  headingIndex,
  embedded = false,
  busy = false,
  copyState = "idle",
} = Astro.props;

// The running project is left out of the switch list by id (not name), so switching to it can't happen from here.
const otherProjects = currentTimer ? projects.filter((project) => project.id !== currentTimer.projectId) : [];

// Long-running flag: computed here when the page renders, from the timer's start; nothing is stored.
const flagged = currentTimer !== null && isTimerFlagged(currentTimer.startedAt, now);
const elapsedHours = currentTimer ? elapsedWholeHours(currentTimer.startedAt, now) : 0;

// The server picks by its own date (UTC); the script below corrects it to the viewer's local date.
const pair = headingIndex === undefined ? headingForDate(new Date()) : headingAtIndex(headingIndex);
const heading = currentTimer ? pair.tracking : pair.idle;

// The four action buttons share one fixed width so they line up in a column down the card.
const actionWidth = "w-21";

const COPY_FAILED = "Couldn't copy — select the link and copy it manually.";
const COPY_DONE = "Link copied to the clipboard.";
const copyStatus = copyState === "failed" ? COPY_FAILED : copyState === "copied" ? COPY_DONE : "";

/** UTC HH:MM fallback for `currentTimer.startedAt`; the client script replaces this with local
 * time once it can. Parses defensively rather than assuming a fixed ISO string layout. */
function formatUtcTime(iso: string): string {
  const date = new Date(iso);
  return Number.isNaN(date.getTime()) ? "—" : date.toISOString().slice(11, 16);
}
---

<PageCard embedded={embedded}>
  <div data-workspace-card data-copy-failed={COPY_FAILED} data-copy-done={COPY_DONE}>
    {unavailable ? (
      <>
        <h1 class="mb-4 text-2xl font-bold text-heading">Temporarily unavailable</h1>
        <p class="text-muted-foreground">We could not load your workspace right now. Please try again in a moment.</p>
        <a href={Astro.url.pathname} class:list={cn(buttonVariants({ variant: "secondary" }), "mt-4")}>
          Try again
        </a>
      </>
    ) : (
      <>
        <h1
          class="mb-4 text-3xl font-bold text-heading"
          data-heading
          data-tracking={currentTimer ? "true" : "false"}
          data-heading-fixed={headingIndex === undefined ? undefined : ""}
        >
          {heading}
        </h1>
        {bannerError && (
          <Alert variant="destructive" className="mb-4">
            <AlertDescription>{bannerError}</AlertDescription>
          </Alert>
        )}
        {bannerStatus && (
          <Alert variant="success" role="status" className="mb-4">
            <AlertDescription>{bannerStatus}</AlertDescription>
          </Alert>
        )}
        {currentTimer ? (
          <div>
            <p class="text-muted-foreground">
              Currently tracking <span class="font-semibold text-card-foreground">{currentTimer.projectName}</span> —
              started at <span data-started-at={currentTimer.startedAt}>{formatUtcTime(currentTimer.startedAt)}</span>
            </p>
            {flagged && (
              <Alert variant="warning" className="mt-4" data-long-running-warning>
                <AlertDescription>
                  This timer has been running for {elapsedHours} hours. Did you forget to stop it? Stopping or switching
                  now records all of that time; if that is too much, you can shorten it afterwards under{" "}
                  <a href={`/w/${token}/corrections`} class="underline underline-offset-4 hover:text-destructive-text">
                    Corrections
                  </a>
                  .
                </AlertDescription>
              </Alert>
            )}
            <form method="post" action={stopAction} class="mt-4">
              <Button
                type="submit"
                variant="secondary"
                className={actionWidth}
                disabled={busy}
                aria-busy={busy ? "true" : undefined}
              >
                Stop
              </Button>
            </form>
            <div class="mt-6">
              <h2 class="mb-2 text-sm font-semibold tracking-wide text-heading uppercase">
                Switch to a different project
              </h2>
              <form method="post" action={switchAction} class="flex gap-2">
                <Input
                  type="text"
                  name="projectName"
                  aria-label="Project to switch to"
                  placeholder="New project name"
                  required
                  maxLength={200}
                />
                <Button type="submit" className={actionWidth} disabled={busy} aria-busy={busy ? "true" : undefined}>
                  Switch
                </Button>
              </form>
              {otherProjects.length > 0 && (
                <ul class="mt-4 space-y-2">
                  {otherProjects.map((project) => (
                    <li>
                      <form method="post" action={switchAction}>
                        <input type="hidden" name="projectName" value={project.name} />
                        <Button
                          type="submit"
                          variant="outline"
                          className="w-full justify-start border-input font-normal"
                        >
                          {project.name}
                        </Button>
                      </form>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ) : (
          <div>
            <form method="post" action={startAction} class="flex gap-2">
              <Input
                type="text"
                name="projectName"
                aria-label="New project name"
                placeholder="New project name"
                required
                maxLength={200}
              />
              <Button type="submit" className={actionWidth} disabled={busy} aria-busy={busy ? "true" : undefined}>
                Start
              </Button>
            </form>
            {projects.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {projects.map((project) => (
                  <li class="flex items-center gap-2">
                    <form method="post" action={startAction} class="flex-1">
                      <input type="hidden" name="projectName" value={project.name} />
                      <Button type="submit" variant="outline" className="w-full justify-start border-input font-normal">
                        {project.name}
                      </Button>
                    </form>
                    <a
                      href={`/w/${token}/projects/${project.id}/delete`}
                      class:list={cn(
                        buttonVariants({ variant: "secondary" }),
                        actionWidth,
                        "hover:text-destructive-text",
                      )}
                    >
                      Delete
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 text-sm text-muted-foreground">No projects yet</p>
            )}
          </div>
        )}

        <div class="mt-8 border-t border-border pt-6">
          <h2 class="mb-2 text-sm font-semibold tracking-wide text-heading uppercase">Weekly summary</h2>
          <a href={`/w/${token}/grid`} class:list={buttonVariants({ variant: "secondary" })}>
            View weekly grid
          </a>
        </div>

        <div class="mt-8 border-t border-border pt-6">
          <h2 class="mb-2 text-sm font-semibold tracking-wide text-heading uppercase">Corrections</h2>
          <p class="mb-2 text-sm text-muted-foreground">Fix a mistake from today or yesterday.</p>
          <a href={`/w/${token}/corrections`} class:list={buttonVariants({ variant: "secondary" })}>
            Open corrections
          </a>
        </div>

        <div class="mt-8 border-t border-border pt-6">
          <h2 class="mb-2 text-sm font-semibold tracking-wide text-heading uppercase">Your private link</h2>
          <div class="flex gap-2">
            <Input type="text" readOnly value={workspaceUrl} aria-label="Your private link" data-link />
            <Button type="button" variant="secondary" className={actionWidth} data-copy>
              {copyState === "copied" ? "Copied" : "Copy"}
            </Button>
          </div>
          <p
            role="status"
            aria-live="polite"
            data-copy-status
            class:list={[
              "text-sm not-empty:mt-2",
              copyState === "failed" ? "text-destructive-text" : "text-muted-foreground",
            ]}
          >
            {copyStatus}
          </p>
          <p class="mt-3 text-sm text-muted-foreground">
            Save this link now. It cannot be recovered, and anyone who has it can see and log your time.
          </p>
          <a
            href={`/w/${token}/regenerate`}
            class:list={cn(buttonVariants({ variant: "secondary" }), actionWidth, "mt-3 hover:text-destructive-text")}
          >
            Regenerate
          </a>
          <div class="mt-3">
            <a
              href={`/w/${token}/delete-account`}
              class:list={cn(buttonVariants({ variant: "secondary" }), "hover:text-destructive-text")}
            >
              Delete all my data
            </a>
          </div>
        </div>
      </>
    )}
  </div>
</PageCard>

<script>
  import { headingForDate } from "@/lib/workspace-headings";

  const COPIED_LABEL_MS = 2000;

  async function copyText(value: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(value);
      return true;
      // eslint-disable-next-line no-restricted-syntax -- client-side clipboard fallback: there is nowhere to report to
    } catch {
      // No clipboard access (blocked, or an insecure context): the caller shows the manual fallback.
      return false;
    }
  }

  for (const card of document.querySelectorAll<HTMLElement>("[data-workspace-card]")) {
    const button = card.querySelector<HTMLButtonElement>("[data-copy]");
    const input = card.querySelector<HTMLInputElement>("[data-link]");
    const status = card.querySelector<HTMLElement>("[data-copy-status]");
    let resetTimer: number | undefined;

    button?.addEventListener("click", () => {
      if (!input || !status) {
        return;
      }
      window.clearTimeout(resetTimer);
      status.textContent = "";
      void copyText(input.value).then((copied) => {
        status.classList.toggle("text-destructive-text", !copied);
        status.classList.toggle("text-muted-foreground", copied);
        if (copied) {
          button.textContent = "Copied";
          status.textContent = card.dataset.copyDone ?? "";
          resetTimer = window.setTimeout(() => {
            button.textContent = "Copy";
            status.textContent = "";
          }, COPIED_LABEL_MS);
        } else {
          // Leave the link selected so the visitor can copy it by hand.
          input.focus();
          input.select();
          status.textContent = card.dataset.copyFailed ?? "";
        }
      });
    });

    // Disable the submit button while its form posts, so a second click cannot send it twice.
    for (const form of card.querySelectorAll<HTMLFormElement>("form")) {
      form.addEventListener("submit", () => {
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submit) {
          submit.disabled = true;
          submit.setAttribute("aria-busy", "true");
        }
      });
    }

    // The server renders started_at in UTC (it can't know the viewer's timezone); replace it with
    // the viewer's local time once the browser can compute it.
    const startedAt = card.querySelector<HTMLElement>("[data-started-at]");
    const startedAtIso = startedAt?.dataset.startedAt;
    if (startedAt && startedAtIso) {
      const date = new Date(startedAtIso);
      if (!Number.isNaN(date.getTime())) {
        startedAt.textContent = date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      }
    }

    // The server picks today's heading by UTC date; use the viewer's local date instead, unless the heading is pinned.
    const heading = card.querySelector<HTMLElement>("[data-heading]");
    if (heading && heading.dataset.headingFixed === undefined) {
      const pair = headingForDate(new Date());
      const text = heading.dataset.tracking === "true" ? pair.tracking : pair.idle;
      if (heading.textContent.trim() !== text) {
        heading.textContent = text;
      }
    }
  }

  // Coming back with the Back button can restore the page from the back/forward cache with its buttons still
  // disabled; re-enable them then.
  window.addEventListener("pageshow", (event) => {
    if (!event.persisted) {
      return;
    }
    for (const submit of document.querySelectorAll<HTMLButtonElement>(
      '[data-workspace-card] button[aria-busy="true"]',
    )) {
      submit.disabled = false;
      submit.removeAttribute("aria-busy");
    }
  });
</script>
