---
import PageCard from "@/components/PageCard.astro";
import Layout from "@/layouts/Layout.astro";

// Unknown /w/<token> requests are rewritten here, so the token must stay out of caches, referrers and indexes.
Astro.response.headers.set("Referrer-Policy", "strict-origin");
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");
---

<Layout title="Page not found">
  <PageCard width="md" class="text-center">
    <h1 class="mb-4 text-3xl font-bold text-heading">Page not found</h1>
    <p class="text-muted-foreground">There is nothing here.</p>
  </PageCard>
</Layout>
