---
import { LINK_CREATION_CLOSED, TURNSTILE_SITE_KEY } from "astro:env/server";
import PageCard from "@/components/PageCard.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { isCreationClosed } from "@/lib/creation-closed";
import { resolveCookieLink } from "@/lib/link-cookie";
import { statusMessage } from "@/lib/status-messages";

// A browser that already holds a valid link goes straight to its workspace.
const linkedToken = await resolveCookieLink(Astro.cookies);
if (linkedToken) {
  return Astro.redirect(`/w/${linkedToken}`);
}

const params = Astro.url.searchParams;
const closed = isCreationClosed(LINK_CREATION_CLOSED) || params.get("closed") === "1";
const full = params.get("full") === "1";

const messages: Record<string, string> = {
  "1": "Something went wrong creating your link. Please try again.",
  busy: "Too many links were created just now; please try again in a few minutes.",
  verify: "Verification failed; please try again.",
};
const error = messages[params.get("error") ?? ""];
const status = statusMessage(params.get("status"));
---

<Layout title="Stopper for Timecards">
  <PageCard width="md" class="text-center">
    <h1 class="mb-4 text-3xl font-bold text-heading">Stopper for Timecards</h1>
    <p class="text-muted-foreground">
      Track your time across projects during the day and get it back as your weekly timesheet grid. There are no
      accounts: your private link is your identity, so keep it safe.
    </p>

    {error && (
      <Alert variant="destructive" className="mt-4">
        <AlertDescription>{error}</AlertDescription>
      </Alert>
    )}

    {status && (
      <Alert variant="success" role="status" className="mt-4">
        <AlertDescription>{status}</AlertDescription>
      </Alert>
    )}

    {full ? (
      <p class="mt-6 text-card-foreground">All 10 spots are taken; no new links can be created.</p>
    ) : closed ? (
      <p class="mt-6 text-card-foreground">New links are closed. If you already have a link, open it directly.</p>
    ) : (
      <form method="POST" action="/api/links" class="mt-6 flex flex-col items-center gap-4">
        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>
        <Button type="submit" size="lg">
          Create my private link
        </Button>
      </form>
    )}
  </PageCard>

  {!full && !closed && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}
</Layout>
