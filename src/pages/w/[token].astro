---
import Layout from "@/layouts/Layout.astro";
import { logAccess } from "@/lib/access-log";
import { LINK_COOKIE, setLinkCookie } from "@/lib/link-cookie";
import { isWellFormedToken } from "@/lib/link-token";
import { findLinkByToken } from "@/lib/links";
import type { Project } from "@/lib/projects";
import { listProjects } from "@/lib/projects";
import { errorMessage, statusMessage } from "@/lib/status-messages";
import type { CurrentTimer } from "@/lib/timer";
import { getCurrentTimer } from "@/lib/timer";

// Keep the token out of caches, referrers and search indexes.
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const { token } = Astro.params;

// Malformed tokens never reach the database or the access log.
if (!isWellFormedToken(token)) {
  return Astro.rewrite("/404");
}

let link: { id: string } | null = null;
let unavailable = false;
try {
  link = await findLinkByToken(token);
} catch {
  unavailable = true;
}

let currentTimer: CurrentTimer = null;
let projects: Project[] = [];

// Awaited on purpose: a promise left running after the response can be cancelled on Workers,
// which would silently drop audit rows.
if (unavailable) {
  await logAccess(null, Astro.request, "error");
  Astro.response.status = 503;
} else if (!link) {
  await logAccess(null, Astro.request, "not_found");
  return Astro.rewrite("/404");
} else {
  await logAccess(link.id, Astro.request, "success");
  // Remember the link only for a browser that has none, so opening someone else's shared link
  // never replaces the visitor's own.
  if (!Astro.cookies.has(LINK_COOKIE)) {
    setLinkCookie(Astro.cookies, token);
  }
  // Read-only: this page only shows state. Starting a timer happens through the form's POST
  // to /api/w/[token]/timer/start, which re-derives the link itself rather than trusting this one.
  const [timer, projectList] = await Promise.all([getCurrentTimer(link.id), listProjects(link.id)]);
  currentTimer = timer;
  projects = projectList;
}

const workspaceUrl = Astro.url.href;
const startAction = `/api/w/${token}/timer/start`;
const bannerError = errorMessage(Astro.url.searchParams.get("error"));
const bannerStatus = statusMessage(Astro.url.searchParams.get("status"));

/** UTC HH:MM fallback for `currentTimer.startedAt`; the client script replaces this with local
 * time once it can. Parses defensively rather than assuming a fixed ISO string layout. */
function formatUtcTime(iso: string): string {
  const date = new Date(iso);
  return Number.isNaN(date.getTime()) ? "—" : date.toISOString().slice(11, 16);
}
---

<Layout title="Your workspace">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      {unavailable ? (
        <>
          <h1 class="mb-4 text-2xl font-bold">Temporarily unavailable</h1>
          <p class="text-blue-100/80">We could not load your workspace right now. Please try again in a moment.</p>
        </>
      ) : (
        <>
          <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Your workspace
          </h1>
          {bannerError && (
            <p class="mb-4 rounded-lg border border-red-400/30 bg-red-500/10 px-3 py-2 text-sm text-red-100">
              {bannerError}
            </p>
          )}
          {bannerStatus && (
            <p class="mb-4 rounded-lg border border-emerald-400/30 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-100">
              {bannerStatus}
            </p>
          )}
          {currentTimer ? (
            <p class="text-blue-100/80">
              Currently tracking <span class="font-semibold text-white">{currentTimer.projectName}</span> — started at{" "}
              <span data-started-at={currentTimer.startedAt}>{formatUtcTime(currentTimer.startedAt)}</span>
            </p>
          ) : (
            <div>
              <form method="post" action={startAction} class="flex gap-2">
                <input
                  type="text"
                  name="projectName"
                  placeholder="New project name"
                  required
                  maxlength="200"
                  class="w-full rounded-lg border border-white/20 bg-black/20 px-3 py-2 text-sm text-white placeholder:text-blue-100/40"
                />
                <button
                  type="submit"
                  class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm whitespace-nowrap transition-colors hover:bg-white/20"
                >
                  Start
                </button>
              </form>
              {projects.length > 0 && (
                <ul class="mt-4 space-y-2">
                  {projects.map((project) => (
                    <li class="flex items-center gap-2">
                      <form method="post" action={startAction} class="flex-1">
                        <input type="hidden" name="projectName" value={project.name} />
                        <button
                          type="submit"
                          class="w-full rounded-lg border border-white/20 bg-black/20 px-3 py-2 text-left text-sm text-white transition-colors hover:bg-white/20"
                        >
                          {project.name}
                        </button>
                      </form>
                      <a
                        href={`/w/${token}/projects/${project.id}/delete`}
                        class="rounded-lg px-3 py-2 text-xs whitespace-nowrap text-blue-100/50 transition-colors hover:text-red-200"
                      >
                        Delete
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}

          <div class="mt-8 border-t border-white/10 pt-6">
            <h2 class="mb-2 text-sm font-semibold tracking-wide text-blue-100/60 uppercase">Your private link</h2>
            <div class="flex gap-2">
              <input
                type="text"
                readonly
                value={workspaceUrl}
                data-link
                class="w-full rounded-lg border border-white/20 bg-black/20 px-3 py-2 text-sm text-white"
              />
              <button
                type="button"
                data-copy
                class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
              >
                Copy
              </button>
            </div>
            <p class="mt-3 text-sm text-blue-100/60">
              Save this link now. It cannot be recovered, and anyone who has it can see and log your time.
            </p>
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  const input = document.querySelector<HTMLInputElement>("[data-link]");

  button?.addEventListener("click", () => {
    if (!input) {
      return;
    }
    void navigator.clipboard.writeText(input.value).then(() => {
      button.textContent = "Copied";
    });
  });

  // The server renders started_at in UTC (it can't know the viewer's timezone); replace it with
  // the viewer's local time once the browser can compute it.
  const startedAt = document.querySelector<HTMLElement>("[data-started-at]");
  const startedAtIso = startedAt?.dataset.startedAt;
  if (startedAt && startedAtIso) {
    const date = new Date(startedAtIso);
    if (!Number.isNaN(date.getTime())) {
      startedAt.textContent = date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    }
  }
</script>
