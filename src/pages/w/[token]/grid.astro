---
import PageCard from "@/components/PageCard.astro";
import WeeklyGridView from "@/components/WeeklyGridView.astro";
import Layout from "@/layouts/Layout.astro";
import { isWellFormedToken } from "@/lib/link-token";
import { findLinkByToken } from "@/lib/links";
import type { GridRow } from "@/lib/weekly-grid";
import { buildWeeklyGrid } from "@/lib/weekly-grid";
import { fetchWeekEntries } from "@/lib/weekly-grid-query";
import { earliestNavigableWeekStart, utcMondayOf } from "@/lib/weekly-grid-retention";

const MS_PER_DAY = 86_400_000;
const MS_PER_WEEK = 7 * MS_PER_DAY;
const WEEK_PARAM_PATTERN = /^\d+$/;

// Keep the token out of caches, referrers and search indexes — the same convention every other tokenized page
// uses (src/pages/w/[token].astro:14-18), even though this page has no form for `no-referrer` to break.
Astro.response.headers.set("Referrer-Policy", "strict-origin");
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const { token } = Astro.params;

// Malformed tokens never reach the database.
if (!isWellFormedToken(token)) {
  return Astro.rewrite("/404");
}

let link: { id: string } | null = null;
let unavailable = false;
try {
  link = await findLinkByToken(token);
} catch {
  unavailable = true;
}

const nowUtc = new Date();
const currentWeekStart = utcMondayOf(nowUtc);
const earliestWeekStart = earliestNavigableWeekStart(nowUtc);

/** Parses `?week=<N>`, the number of whole weeks before the current UTC week (`0` = current week, `1` = last
 * week, and so on) — never an absolute calendar/ISO week number, which would need a year anchor and disagrees
 * with itself across a year boundary. Missing, malformed, or out-of-range values (before the earliest
 * navigable week; the pattern already rules out negative/future values) all fall back to the current UTC week. */
function parseViewedWeekStart(weekParam: string | null): Date {
  if (!weekParam || !WEEK_PARAM_PATTERN.test(weekParam)) {
    return currentWeekStart;
  }
  const weeksAgo = Number(weekParam);
  if (!Number.isSafeInteger(weeksAgo)) {
    return currentWeekStart;
  }
  const candidate = new Date(currentWeekStart.getTime() - weeksAgo * MS_PER_WEEK);
  if (candidate.getTime() < earliestWeekStart.getTime()) {
    return currentWeekStart;
  }
  return candidate;
}

const viewedWeekStart = parseViewedWeekStart(Astro.url.searchParams.get("week"));

let rows: GridRow[] = [];

// No logAccess call here, matching src/pages/w/[token]/projects/[projectId]/delete.astro's precedent:
// nested pages under /w/[token]/... are reached from an already-logged workspace visit, so only the
// primary workspace page (src/pages/w/[token].astro) records access.
if (unavailable) {
  Astro.response.status = 503;
} else if (!link) {
  return Astro.rewrite("/404");
} else {
  try {
    const entries = await fetchWeekEntries(link.id, viewedWeekStart);
    rows = buildWeeklyGrid(entries, viewedWeekStart, nowUtc);
  } catch {
    // Same "temporarily unavailable" page as a failed link lookup, instead of an unhandled server error.
    unavailable = true;
    Astro.response.status = 503;
  }
}

const showPrevious = viewedWeekStart.getTime() > earliestWeekStart.getTime();
const showNext = viewedWeekStart.getTime() < currentWeekStart.getTime();
const previousWeekStart = new Date(viewedWeekStart.getTime() - MS_PER_WEEK);
const nextWeekStart = new Date(viewedWeekStart.getTime() + MS_PER_WEEK);

/** The `?week=<N>` value for a UTC-Monday `weekStart`: how many whole weeks before `currentWeekStart` it is. */
function toWeekParam(weekStart: Date): string {
  return String(Math.round((currentWeekStart.getTime() - weekStart.getTime()) / MS_PER_WEEK));
}

/** e.g. "Sep 21 – Sep 27, 2026" for the week starting at `weekStart` (a UTC Monday). */
function formatWeekRange(weekStart: Date): string {
  const weekEnd = new Date(weekStart.getTime() + 6 * MS_PER_DAY);
  const startLabel = weekStart.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
  const endLabel = weekEnd.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });
  return `${startLabel} – ${endLabel}`;
}

const weekLabel = formatWeekRange(viewedWeekStart);
const workspaceUrl = `/w/${token}`;
---

<Layout title="Weekly grid">
  <PageCard>
    <div>
      {unavailable ? (
        <>
          <h1 class="mb-4 text-2xl font-bold text-heading">Temporarily unavailable</h1>
          <p class="text-muted-foreground">We could not load your workspace right now. Please try again in a moment.</p>
        </>
      ) : (
        <>
          <a
            href={workspaceUrl}
            class="mb-4 inline-block text-sm text-muted-foreground underline-offset-4 hover:text-card-foreground hover:underline"
          >
            ← Back to workspace
          </a>
          <WeeklyGridView
            weekLabel={weekLabel}
            showPrevious={showPrevious}
            showNext={showNext}
            previousHref={`?week=${toWeekParam(previousWeekStart)}`}
            nextHref={`?week=${toWeekParam(nextWeekStart)}`}
            rows={rows}
          />
        </>
      )}
    </div>
  </PageCard>
</Layout>
