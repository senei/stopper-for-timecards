---
import PageCard from "@/components/PageCard.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { isWellFormedToken } from "@/lib/link-token";
import { findLinkByToken } from "@/lib/links";
import type { GridRow } from "@/lib/weekly-grid";
import { buildWeeklyGrid } from "@/lib/weekly-grid";
import { fetchWeekEntries } from "@/lib/weekly-grid-query";
import { earliestNavigableWeekStart } from "@/lib/weekly-grid-retention";

const MS_PER_DAY = 86_400_000;
const WEEK_PARAM_PATTERN = /^\d{4}-\d{2}-\d{2}$/;
const DAY_LABELS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] as const;

// Keep the token out of caches, referrers and search indexes — the same convention every other tokenized page
// uses (src/pages/w/[token].astro:14-18), even though this page has no form for `no-referrer` to break.
Astro.response.headers.set("Referrer-Policy", "strict-origin");
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");

const { token } = Astro.params;

// Malformed tokens never reach the database.
if (!isWellFormedToken(token)) {
  return Astro.rewrite("/404");
}

let link: { id: string } | null = null;
let unavailable = false;
try {
  link = await findLinkByToken(token);
} catch {
  unavailable = true;
}

/** UTC Monday 00:00:00.000 of the week containing `date` (mirrors weekly-grid-retention.ts's unexported helper,
 * which isn't exported for reuse here). */
function utcMondayOf(date: Date): Date {
  const dayNumber = Math.floor(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()) / MS_PER_DAY);
  // getUTCDay(): 0 = Sunday .. 6 = Saturday; days elapsed since the most recent Monday.
  const daysSinceMonday = (date.getUTCDay() + 6) % 7;
  return new Date((dayNumber - daysSinceMonday) * MS_PER_DAY);
}

const nowUtc = new Date();
const currentWeekStart = utcMondayOf(nowUtc);
const earliestWeekStart = earliestNavigableWeekStart(nowUtc);

/** Parses `?week=YYYY-MM-DD` and snaps it to that date's UTC Monday. Missing, malformed, or out-of-range values
 * (either past the current week or before the earliest navigable week) all fall back to the current UTC week. */
function parseViewedWeekStart(weekParam: string | null): Date {
  if (!weekParam || !WEEK_PARAM_PATTERN.test(weekParam)) {
    return currentWeekStart;
  }
  const parsed = new Date(`${weekParam}T00:00:00.000Z`);
  if (Number.isNaN(parsed.getTime())) {
    return currentWeekStart;
  }
  const snapped = utcMondayOf(parsed);
  if (snapped.getTime() > currentWeekStart.getTime() || snapped.getTime() < earliestWeekStart.getTime()) {
    return currentWeekStart;
  }
  return snapped;
}

const viewedWeekStart = parseViewedWeekStart(Astro.url.searchParams.get("week"));

let rows: GridRow[] = [];

// No logAccess call here, matching src/pages/w/[token]/projects/[projectId]/delete.astro's precedent:
// nested pages under /w/[token]/... are reached from an already-logged workspace visit, so only the
// primary workspace page (src/pages/w/[token].astro) records access.
if (unavailable) {
  Astro.response.status = 503;
} else if (!link) {
  return Astro.rewrite("/404");
} else {
  const entries = await fetchWeekEntries(link.id, viewedWeekStart);
  rows = buildWeeklyGrid(entries, viewedWeekStart, nowUtc);
}

const showPrevious = viewedWeekStart.getTime() > earliestWeekStart.getTime();
const showNext = viewedWeekStart.getTime() < currentWeekStart.getTime();
const previousWeekStart = new Date(viewedWeekStart.getTime() - 7 * MS_PER_DAY);
const nextWeekStart = new Date(viewedWeekStart.getTime() + 7 * MS_PER_DAY);

/** `YYYY-MM-DD` for the `?week=` query param, from a UTC-midnight Date. */
function toWeekParam(date: Date): string {
  return date.toISOString().slice(0, 10);
}

/** e.g. "Sep 21 – Sep 27, 2026" for the week starting at `weekStart` (a UTC Monday). */
function formatWeekRange(weekStart: Date): string {
  const weekEnd = new Date(weekStart.getTime() + 6 * MS_PER_DAY);
  const startLabel = weekStart.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
  const endLabel = weekEnd.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });
  return `${startLabel} – ${endLabel}`;
}

/** Raw minutes (already rounded up to a 15-minute increment by buildWeeklyGrid) as `H:MM`; zero renders as an
 * em dash rather than "0:00". */
function formatMinutes(minutes: number): string {
  if (minutes === 0) {
    return "—";
  }
  const hours = Math.floor(minutes / 60);
  const remainder = minutes % 60;
  return `${hours}:${String(remainder).padStart(2, "0")}`;
}

const weekLabel = formatWeekRange(viewedWeekStart);
const workspaceUrl = `/w/${token}`;
---

<Layout title="Weekly grid">
  <PageCard>
    <div>
      {unavailable ? (
        <>
          <h1 class="mb-4 text-2xl font-bold text-heading">Temporarily unavailable</h1>
          <p class="text-muted-foreground">We could not load your workspace right now. Please try again in a moment.</p>
        </>
      ) : (
        <>
          <a
            href={workspaceUrl}
            class="mb-4 inline-block text-sm text-muted-foreground underline-offset-4 hover:text-card-foreground hover:underline"
          >
            ← Back to workspace
          </a>
          <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
            <div>
              <h1 class="text-3xl font-bold text-heading">Weekly grid</h1>
              <p class="mt-1 text-muted-foreground">{weekLabel}</p>
            </div>
            <div class="flex gap-2">
              {showPrevious && (
                <a
                  href={`?week=${toWeekParam(previousWeekStart)}`}
                  class:list={buttonVariants({ variant: "secondary", size: "sm" })}
                >
                  ← Previous week
                </a>
              )}
              {showNext && (
                <a
                  href={`?week=${toWeekParam(nextWeekStart)}`}
                  class:list={buttonVariants({ variant: "secondary", size: "sm" })}
                >
                  Next week →
                </a>
              )}
            </div>
          </div>
          {rows.length === 0 ? (
            <Alert role="status">
              <AlertDescription>No time was logged for this week.</AlertDescription>
            </Alert>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-sm">
                <thead>
                  <tr class="border-b border-border text-left text-muted-foreground">
                    <th class="py-2 pr-4 font-medium">Project</th>
                    {DAY_LABELS.map((label) => (
                      <th class="px-2 py-2 text-right font-medium">{label}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {rows.map((row) => (
                    <tr class="border-b border-border last:border-b-0">
                      <td class="py-2 pr-4 text-card-foreground">
                        <div>{row.projectName}</div>
                        <div class="text-xs text-muted-foreground">
                          {row.task ?? "—"} - {row.type} - {row.workType}
                        </div>
                      </td>
                      {row.dailyMinutes.map((minutes) => (
                        <td class="px-2 py-2 text-right text-card-foreground">{formatMinutes(minutes)}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </>
      )}
    </div>
  </PageCard>
</Layout>
